# Copy this file to .env and fill in real values for local development.

# PostgreSQL connection string. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://ontime:ontime@localhost:5432/ontime?schema=public"

# Used to sign session cookies (jose/HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app, used to build absolute links in emails
# (verification, password reset). No trailing slash.
APP_URL="http://localhost:3000"

# SMTP settings for sending real email. If SMTP_HOST is unset, the app
# falls back to logging emails to the console instead of sending them,
# which is fine for local development.
#
# For Gmail: host is smtp.gmail.com, port 587. SMTP_USER must be the full
# Gmail address, and SMTP_PASSWORD must be a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords) — the
# regular account password will be rejected once 2FA is enabled. Gmail
# also requires the SMTP_FROM address to match the authenticated SMTP_USER
# (or a verified "Send As" alias on that account); a from address on a
# different domain, like the ontime.am default below, will be rejected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="On-Time <no-reply@ontime.am>"

# Shared secret checked by /api/notifications/process (see vercel.json).
# Vercel automatically sends this as a Bearer token on Cron-triggered
# requests when set. Leave unset in local dev to call the route without
# auth; always set it in production. Generate the same way as AUTH_SECRET.
CRON_SECRET=

# Supabase project used for Storage (profile/cover/portfolio photo uploads —
# see src/lib/storage.ts). Vercel's filesystem is ephemeral, so uploads are
# saved there instead of local disk.
#
# SUPABASE_URL is the project's API URL (Project Settings > Data API).
# SUPABASE_SERVICE_ROLE_KEY MUST be the "service_role" secret key (Project
# Settings > API Keys) — NOT the anon/publishable key. The service role key
# bypasses Storage RLS, which is required since the bucket has no public
# write policy; every upload is already gated by the caller's session in
# app code, so the service role key is only ever used server-side and must
# never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Name of the public Storage bucket to upload into. Defaults to "Uploads".
SUPABASE_STORAGE_BUCKET=

# Hours before an appointment that its reminder notification is sent
# (07_Business_Rules.md: reminder timing is an open decision — 24h is the
# v1 default; override here without a code change if that changes).
REMINDER_LEAD_HOURS=24
