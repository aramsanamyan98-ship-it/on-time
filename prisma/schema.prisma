// Prisma schema for On-Time (see docs/05_Database.md)
//
// Build stage: auth (specialists + token tables), Phase 2 specialist-profile
// tables (services, working_hours), Phase 3 portfolio_photos, Phase 4
// booking-engine tables (appointments, blocked_time), Phase 5 client_notes,
// Phase 6 notifications_log, and Phase 7 referrals + trial/subscription
// fields on `specialists`, per docs/08_Roadmap.md.
//
// Deviations from the literal field list in 05_Database.md, and why:
// - `display_name` and `slug` are populated automatically at registration
//   (slug from a slugified/uniquified display_name, display_name from the
//   email's local part) rather than collected in a form. Both remain
//   editable once profile UI exists — the doc already calls the slug
//   "auto-generated from name, editable once", so this just applies the
//   same pattern to display_name. Editing either is still not built (not
//   required by 08_Roadmap.md Phase 2's field list).
// - `working_hours.start_time`/`end_time` are stored as "HH:mm" strings
//   rather than a DB `time` column: v1 only needs them for display and
//   slot-generation math done in application code (Phase 4), and a plain
//   string avoids Prisma's `@db.Time` values round-tripping as full `Date`
//   objects for what is really just a wall-clock time.
// - `appointments.booking_token` is stored as the raw random token (not a
//   hash like the auth token tables). Unlike a password-reset/verification
//   token, this is a long-lived capability link a guest may reopen many
//   times (view, then later cancel/reschedule) rather than a one-time
//   secret exchanged once, 05_Database.md names the column `booking_token`
//   (not `_hash`) exactly for this reason, and 32 bytes of CSPRNG output is
//   already unguessable without needing the extra hash-on-lookup layer.
// - The no-double-booking rule (05_Database.md) is enforced with a
//   Postgres EXCLUDE constraint (`btree_gist`, gist index on
//   specialist_id + tstzrange(start_at, end_at), partial WHERE status <>
//   'cancelled') rather than a plain unique constraint, since bookings
//   aren't on a fixed slot grid — any two overlapping ranges must be
//   rejected, not just exact duplicate start times. Prisma's schema DSL
//   can't express EXCLUDE constraints, so it's added by hand-editing the
//   generated migration SQL (see prisma/migrations).
// - Phase 7 (02_PRD.md Section 14 / 08_Roadmap.md): `specialists.plan`
//   deliberately never gets written to "starter"/"pro" by any code in this
//   phase (no billing integration exists yet to justify it) and the trial
//   "drop to Basic" on expiry is likewise never a write — every read site
//   computes effective access from `plan` + `trialEndsAt` together (see
//   src/lib/subscription/trial.ts `hasFullAccess`) rather than mutating
//   `plan`, so trial expiry needs no cron/background job to "downgrade"
//   anyone (08_Roadmap.md Phase 7 exit criteria: "works automatically
//   without manual intervention").
// - `referralExtensionsGranted` exists because the referral trial
//   extension is stated as an incremental grant (07_Business_Rules.md: "+7
//   days per 5 referrals" repeats per block of 5) — it needs a persisted
//   marker so re-evaluating after every referral can't double-grant when a
//   count later dips (e.g. a cancellation) and climbs back up.
// - 02_PRD.md Section 14 was revised post-Phase-7 (see 08_Roadmap.md):
//   flat 3-month trial replaces the old 30-day + booking-milestone
//   extension, so `bookingMilestoneExtendedAt` and the old
//   `booking_milestone_extended_at` column were removed (see the
//   `remove_booking_milestone_phase7_update` migration) rather than kept
//   as a dead field.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  am
  ru
  en
}

enum Plan {
  basic
  starter
  pro
}

enum AppointmentStatus {
  confirmed
  cancelled
  completed
  no_show
}

enum AppointmentSource {
  guest_booking
  manual_specialist_entry
}

// See 05_Database.md `referrals` and 07_Business_Rules.md Trial & Billing
// Rules. `invited` is set when a specialist proactively sends an invite
// (Referral.referredEmail known up front); a referral can also be created
// directly as `booked_first_appointment` when a guest arrives via the
// specialist's referral link and books without a prior invite — see
// src/lib/subscription/referrals.ts.
enum ReferralStatus {
  invited
  booked_first_appointment
}

// See 05_Database.md `notifications_log` and 02_PRD.md Section 9: guests
// get `booking_confirmation`/`reminder`; specialists get `new_booking_alert`
// (new guest booking), `cancellation` (guest-initiated cancel), and
// `reschedule_alert` (guest-initiated reschedule) — the specialist-side
// half of 07_Business_Rules.md's "the specialist is notified whenever a
// guest cancels or reschedules via their link, the same as if the
// specialist had made the change." `reschedule_alert` isn't in
// 05_Database.md's literal type list; added because reusing
// `new_booking_alert` for a reschedule would make the audit log say "new
// booking" for something that wasn't one. Non-email channels remain
// documented-but-not-yet-triggered (see `NotificationChannel`).
enum NotificationType {
  booking_confirmation
  reminder
  cancellation
  new_booking_alert
  reschedule_alert
}

enum NotificationChannel {
  email
  whatsapp
  telegram
  sms
}

enum NotificationStatus {
  queued
  sent
  failed
}

model Specialist {
  id                            String    @id @default(uuid())
  email                         String    @unique
  passwordHash                  String    @map("password_hash")
  emailVerifiedAt               DateTime? @map("email_verified_at")
  displayName                   String    @map("display_name")
  slug                          String    @unique
  profilePhotoUrl               String?   @map("profile_photo_url")
  coverPhotoUrl                 String?   @map("cover_photo_url")
  bio                           String?
  phone                         String?
  address                       String?
  timezone                      String    @default("Asia/Yerevan")
  instagramUrl                  String?   @map("instagram_url")
  languagePreference            Language  @default(am) @map("language_preference")
  plan                          Plan      @default(basic)
  trialEndsAt                   DateTime? @map("trial_ends_at")
  // Phase 7 (08_Roadmap.md / 02_PRD.md Section 14) — see schema header
  // comment for why these are additive markers rather than derived values.
  referralCode                  String    @unique @map("referral_code")
  referralExtensionsGranted     Int       @default(0) @map("referral_extensions_granted")
  // Dismissal state for the "5 bookings received" upgrade nudge
  // (04_User_Flows.md Flow 5 step 5) — the prompt is informational/
  // non-blocking, so once a specialist dismisses it, it shouldn't keep
  // reappearing on every dashboard page load.
  subscriptionPromptDismissedAt DateTime? @map("subscription_prompt_dismissed_at")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")
  deletedAt                     DateTime? @map("deleted_at")

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  services                Service[]
  workingHours            WorkingHours[]
  portfolioPhotos         PortfolioPhoto[]
  appointments            Appointment[]
  blockedTime             BlockedTime[]
  clientNotes             ClientNote[]
  referrals               Referral[]

  @@map("specialists")
}

model Service {
  id              String     @id @default(uuid())
  specialistId    String     @map("specialist_id")
  specialist      Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int        @map("duration_minutes")
  priceAmd        Int        @map("price_amd")
  description     String?
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([specialistId])
  @@map("services")
}

// dayOfWeek follows JS Date#getDay() convention: 0 = Sunday ... 6 = Saturday.
// Exactly one row per specialist per day of week (upserted as a set from
// the working-hours settings form) — see docs/05_Database.md.
model WorkingHours {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        @map("day_of_week")
  startTime    String?    @map("start_time") // "HH:mm", null when isDayOff
  endTime      String?    @map("end_time") // "HH:mm", null when isDayOff
  isDayOff     Boolean    @default(false) @map("is_day_off")

  @@unique([specialistId, dayOfWeek])
  @@map("working_hours")
}

model PortfolioPhoto {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  imageUrl     String     @map("image_url")
  sortOrder    Int        @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("portfolio_photos")
}

// Specialist-private unavailable time (lunch, personal errands, etc.) that
// blocks slot generation the same way an appointment does, without being
// one (07_Business_Rules.md / 05_Database.md). No management UI ships in
// Phase 4 — see 08_Roadmap.md Phase 4 scope — but the availability engine
// already reads this table so it's ready for that UI later.
model BlockedTime {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  startAt      DateTime   @map("start_at")
  endAt        DateTime   @map("end_at")
  reason       String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("blocked_time")
}

// See 05_Database.md `appointments` and 07_Business_Rules.md Booking Rules.
// The no-overlap guarantee is a Postgres EXCLUDE constraint added by hand
// to the generated migration (Prisma can't express it) — see the schema
// header comment above.
model Appointment {
  id           String            @id @default(uuid())
  specialistId String            @map("specialist_id")
  specialist   Specialist        @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceId    String            @map("service_id")
  // Services are only ever deactivated, never deleted, from the app
  // (07_Business_Rules.md: "past appointments ... must remain intact") —
  // Restrict makes that invariant explicit at the DB level too.
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  startAt      DateTime          @map("start_at")
  endAt        DateTime          @map("end_at")
  status       AppointmentStatus @default(confirmed)
  guestName    String            @map("guest_name")
  guestPhone   String            @map("guest_phone")
  guestEmail   String?           @map("guest_email")
  guestNotes   String?           @map("guest_notes")
  source       AppointmentSource @default(guest_booking)
  bookingToken String            @unique @map("booking_token")
  // The guest's own language at booking time (02_PRD.md Section 2: guest
  // language is "stored per booking", independent of the specialist's
  // dashboard language) — captured here because notifications (Phase 6)
  // are sent asynchronously, sometimes hours later via the reminder queue,
  // long after any request/cookie context from the original booking is
  // gone.
  guestLocale  Language          @default(am) @map("guest_locale")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  notifications NotificationLog[]

  @@index([specialistId])
  @@index([serviceId])
  @@map("appointments")
}

// Queue + audit log for notification delivery (05_Database.md
// `notifications_log`, 02_PRD.md Section 9, 08_Roadmap.md Phase 6). An
// appointment's success never depends on this table — appointments are
// always written first; this only records the separate, retryable act of
// telling someone about it (07_Business_Rules.md Notifications, 10_Risks.md
// "Client books but specialist doesn't receive it").
model NotificationLog {
  id            String              @id @default(uuid())
  appointmentId String              @map("appointment_id")
  appointment   Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          NotificationType
  channel       NotificationChannel @default(email)
  recipient     String
  status        NotificationStatus  @default(queued)
  // When this notification becomes eligible to send: "now" for a
  // confirmation, `appointment.startAt` minus the reminder lead time for a
  // reminder — see REMINDER_LEAD_HOURS in src/lib/notifications/queue.ts.
  scheduledFor  DateTime            @map("scheduled_for")
  attempts      Int                 @default(0)
  attemptedAt   DateTime?           @map("attempted_at")
  errorMessage  String?             @map("error_message")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@index([appointmentId])
  @@map("notifications_log")
}

// Per-client manual notes (02_PRD.md Section 10 — "not a full CRM ... just a
// list and history"). There's no `customers` table in v1 (05_Database.md
// defers that); clients are identified the same way appointments already
// identify guests — by phone, scoped to one specialist — rather than via a
// customer FK. One row per (specialist, guest phone) pair.
model ClientNote {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  guestPhone   String     @map("guest_phone")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([specialistId, guestPhone])
  @@map("client_notes")
}

// Referral growth mechanic feeding the trial-extension rule (05_Database.md
// `referrals`, 07_Business_Rules.md, 08_Roadmap.md Phase 7). One row per
// invited/referred guest per specialist. `referredEmail`/`referredPhone`
// mirror the "email or phone" wording in 05_Database.md — whichever the
// specialist had at invite time, or whichever the guest provided at
// booking time when there was no prior invite (see
// src/lib/subscription/referrals.ts).
model Referral {
  id            String         @id @default(uuid())
  specialistId  String         @map("specialist_id")
  specialist    Specialist     @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  referredEmail String?        @map("referred_email")
  referredPhone String?        @map("referred_phone")
  status        ReferralStatus @default(invited)
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("referrals")
}

model EmailVerificationToken {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at")
  consumedAt   DateTime?  @map("consumed_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at")
  consumedAt   DateTime?  @map("consumed_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("password_reset_tokens")
}
