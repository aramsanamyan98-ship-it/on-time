// Prisma schema for On-Time (see docs/05_Database.md)
//
// Build stage: auth (specialists + token tables), Phase 2 specialist-profile
// tables (services, working_hours), Phase 3 portfolio_photos, Phase 4
// booking-engine tables (appointments, blocked_time), Phase 5 client_notes,
// Phase 6 notifications_log, and Phase 7 trial/subscription fields on
// `specialists`, per docs/08_Roadmap.md.
//
// Deviations from the literal field list in 05_Database.md, and why:
// - `display_name` and `slug` are populated automatically at registration
//   (slug from a slugified/uniquified display_name, display_name from the
//   email's local part) rather than collected in a form. Both remain
//   editable once profile UI exists — the doc already calls the slug
//   "auto-generated from name, editable once", so this just applies the
//   same pattern to display_name. Editing either is still not built (not
//   required by 08_Roadmap.md Phase 2's field list).
// - `working_hours.start_time`/`end_time` are stored as "HH:mm" strings
//   rather than a DB `time` column: v1 only needs them for display and
//   slot-generation math done in application code (Phase 4), and a plain
//   string avoids Prisma's `@db.Time` values round-tripping as full `Date`
//   objects for what is really just a wall-clock time.
// - `appointments.booking_token` is stored as the raw random token (not a
//   hash like the auth token tables). Unlike a password-reset/verification
//   token, this is a long-lived capability link a guest may reopen many
//   times (view, then later cancel/reschedule) rather than a one-time
//   secret exchanged once, 05_Database.md names the column `booking_token`
//   (not `_hash`) exactly for this reason, and 32 bytes of CSPRNG output is
//   already unguessable without needing the extra hash-on-lookup layer.
// - The no-double-booking rule (05_Database.md) is enforced with a
//   Postgres EXCLUDE constraint (`btree_gist`, gist index on
//   specialist_id + tstzrange(start_at, end_at), partial WHERE status <>
//   'cancelled') rather than a plain unique constraint, since bookings
//   aren't on a fixed slot grid — any two overlapping ranges must be
//   rejected, not just exact duplicate start times. Prisma's schema DSL
//   can't express EXCLUDE constraints, so it's added by hand-editing the
//   generated migration SQL (see prisma/migrations).
// - 02_PRD.md Section 14 (final pricing model): there is no tiered `plan`
//   anymore — every paying specialist gets identical features, and only
//   commitment length varies price. `subscriptionActiveUntil` is the single
//   source of truth for "paid access through this date"; there's no
//   billing integration yet, so it's only ever written by a manual/admin
//   action once payment is arranged off-platform (same "simple invoice
//   process" the doc always allowed) — never by app code on a schedule.
//   Effective dashboard/booking access is computed by ORing this against
//   `trialEndsAt` (see src/lib/subscription/trial.ts `hasActiveAccess`),
//   so trial expiry needs no cron/downgrade job: a specialist whose trial
//   has ended and has no `subscriptionActiveUntil` in the future simply
//   reads as blocked.
// - `reviews` (08_Roadmap.md Phase 9, 02_PRD.md Section 14 — displayed on
//   every paid plan): `appointmentId` is `@unique`
//   rather than a plain FK — that's
//   the entire enforcement of "one review per appointment, no editing" (a
//   second insert for the same appointment simply violates the unique
//   constraint; there's no update path in the app at all, matching "no
//   editing after submission"). `specialistId` is denormalized onto the
//   row (not just reachable via `appointment.specialistId`) so the public
//   profile page and dashboard reviews list can query/aggregate directly
//   by specialist without joining through `appointments` for every read —
//   the same rationale as `ClientNote.specialistId` below. Guest identity
//   (name/phone) is deliberately NOT copied onto `Review` — the public
//   profile only ever needs the guest's first name for display, which is
//   read from `appointment.guestName` at query time, keeping the privacy
//   boundary (no phone, no full name) enforced by what the query selects
//   rather than by what's stored.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  am
  ru
  en
}

enum AppointmentStatus {
  confirmed
  cancelled
  completed
  no_show
}

enum AppointmentSource {
  guest_booking
  manual_specialist_entry
}

// See 05_Database.md `notifications_log` and 02_PRD.md Section 9: guests
// get `booking_confirmation`/`reminder`; specialists get `new_booking_alert`
// (new guest booking), `cancellation` (guest-initiated cancel), and
// `reschedule_alert` (guest-initiated reschedule) — the specialist-side
// half of 07_Business_Rules.md's "the specialist is notified whenever a
// guest cancels or reschedules via their link, the same as if the
// specialist had made the change." `reschedule_alert` isn't in
// 05_Database.md's literal type list; added because reusing
// `new_booking_alert` for a reschedule would make the audit log say "new
// booking" for something that wasn't one. Non-email channels remain
// documented-but-not-yet-triggered (see `NotificationChannel`).
//
// `rebooking_notice` (rebooking-assist feature): the guest-facing
// counterpart of a *specialist*-initiated cancellation — whether from a
// direct dashboard cancel or a blocked-time conflict — prompting the guest
// to pick a new slot themselves via their existing booking_token link
// (see src/lib/booking/cancel-booking.ts). Deliberately not reusing
// `cancellation` (that type is specialist-facing, for guest-initiated
// cancels) for the same reason `reschedule_alert` isn't reused for
// `new_booking_alert` above — same rationale, opposite direction.
enum NotificationType {
  booking_confirmation
  reminder
  cancellation
  new_booking_alert
  reschedule_alert
  review_request
  rebooking_notice
}

enum NotificationChannel {
  email
  whatsapp
  telegram
  sms
}

enum NotificationStatus {
  queued
  sent
  failed
}

model Specialist {
  id                            String    @id @default(uuid())
  email                         String    @unique
  passwordHash                  String    @map("password_hash")
  emailVerifiedAt               DateTime? @map("email_verified_at")
  displayName                   String    @map("display_name")
  slug                          String    @unique
  profilePhotoUrl               String?   @map("profile_photo_url")
  coverPhotoUrl                 String?   @map("cover_photo_url")
  bio                           String?
  phone                         String?
  address                       String?
  timezone                      String    @default("Asia/Yerevan")
  instagramUrl                  String?   @map("instagram_url")
  facebookUrl                   String?   @map("facebook_url")
  languagePreference            Language  @default(am) @map("language_preference")
  trialEndsAt                   DateTime? @map("trial_ends_at")
  // 02_PRD.md Section 14 (final pricing model) — see schema header comment.
  // `subscriptionCommitmentMonths` is one of 1/3/6/12 (price-per-month
  // varies by commitment length only, see src/lib/subscription/pricing.ts);
  // `subscriptionActiveUntil` is the paid-through date. Both null until a
  // specialist has ever subscribed.
  subscriptionCommitmentMonths  Int?      @map("subscription_commitment_months")
  subscriptionActiveUntil       DateTime? @map("subscription_active_until")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")
  deletedAt                     DateTime? @map("deleted_at")

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  services                Service[]
  workingHours            WorkingHours[]
  portfolioPhotos         PortfolioPhoto[]
  appointments            Appointment[]
  blockedTime             BlockedTime[]
  clientNotes             ClientNote[]
  reviews                 Review[]

  @@map("specialists")
}

model Service {
  id              String     @id @default(uuid())
  specialistId    String     @map("specialist_id")
  specialist      Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int        @map("duration_minutes")
  priceAmd        Int        @map("price_amd")
  description     String?
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([specialistId])
  @@map("services")
}

// dayOfWeek follows JS Date#getDay() convention: 0 = Sunday ... 6 = Saturday.
// Exactly one row per specialist per day of week (upserted as a set from
// the working-hours settings form) — see docs/05_Database.md.
model WorkingHours {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        @map("day_of_week")
  startTime    String?    @map("start_time") // "HH:mm", null when isDayOff
  endTime      String?    @map("end_time") // "HH:mm", null when isDayOff
  isDayOff     Boolean    @default(false) @map("is_day_off")

  @@unique([specialistId, dayOfWeek])
  @@map("working_hours")
}

model PortfolioPhoto {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  imageUrl     String     @map("image_url")
  sortOrder    Int        @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("portfolio_photos")
}

// Specialist-private unavailable time (lunch, personal errands, etc.) that
// blocks slot generation the same way an appointment does, without being
// one (07_Business_Rules.md / 05_Database.md). Management UI (create/list/
// delete, with a conflict-confirmation step against existing confirmed
// appointments) ships with the rebooking-assist feature — see
// src/lib/booking/blocked-time.ts and src/app/[locale]/dashboard/blocked-time.
model BlockedTime {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  startAt      DateTime   @map("start_at")
  endAt        DateTime   @map("end_at")
  reason       String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("blocked_time")
}

// See 05_Database.md `appointments` and 07_Business_Rules.md Booking Rules.
// The no-overlap guarantee is a Postgres EXCLUDE constraint added by hand
// to the generated migration (Prisma can't express it) — see the schema
// header comment above.
model Appointment {
  id           String            @id @default(uuid())
  specialistId String            @map("specialist_id")
  specialist   Specialist        @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  serviceId    String            @map("service_id")
  // Services are only ever deactivated, never deleted, from the app
  // (07_Business_Rules.md: "past appointments ... must remain intact") —
  // Restrict makes that invariant explicit at the DB level too.
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  startAt      DateTime          @map("start_at")
  endAt        DateTime          @map("end_at")
  status       AppointmentStatus @default(confirmed)
  guestName    String            @map("guest_name")
  guestPhone   String            @map("guest_phone")
  guestEmail   String?           @map("guest_email")
  guestNotes   String?           @map("guest_notes")
  source       AppointmentSource @default(guest_booking)
  bookingToken String            @unique @map("booking_token")
  // The guest's own language at booking time (02_PRD.md Section 2: guest
  // language is "stored per booking", independent of the specialist's
  // dashboard language) — captured here because notifications (Phase 6)
  // are sent asynchronously, sometimes hours later via the reminder queue,
  // long after any request/cookie context from the original booking is
  // gone.
  guestLocale  Language          @default(am) @map("guest_locale")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  notifications NotificationLog[]
  review        Review?

  @@index([specialistId])
  @@index([serviceId])
  @@map("appointments")
}

// Queue + audit log for notification delivery (05_Database.md
// `notifications_log`, 02_PRD.md Section 9, 08_Roadmap.md Phase 6). An
// appointment's success never depends on this table — appointments are
// always written first; this only records the separate, retryable act of
// telling someone about it (07_Business_Rules.md Notifications, 10_Risks.md
// "Client books but specialist doesn't receive it").
model NotificationLog {
  id            String              @id @default(uuid())
  appointmentId String              @map("appointment_id")
  appointment   Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          NotificationType
  channel       NotificationChannel @default(email)
  recipient     String
  status        NotificationStatus  @default(queued)
  // When this notification becomes eligible to send: "now" for a
  // confirmation, `appointment.startAt` minus the reminder lead time for a
  // reminder — see REMINDER_LEAD_HOURS in src/lib/notifications/queue.ts.
  scheduledFor  DateTime            @map("scheduled_for")
  attempts      Int                 @default(0)
  attemptedAt   DateTime?           @map("attempted_at")
  errorMessage  String?             @map("error_message")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@index([appointmentId])
  @@map("notifications_log")
}

// Per-client manual notes (02_PRD.md Section 10 — "not a full CRM ... just a
// list and history"). There's no `customers` table in v1 (05_Database.md
// defers that); clients are identified the same way appointments already
// identify guests — by phone, scoped to one specialist — rather than via a
// customer FK. One row per (specialist, guest phone) pair.
model ClientNote {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  guestPhone   String     @map("guest_phone")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([specialistId, guestPhone])
  @@map("client_notes")
}

// Guest-authored review of a completed appointment (08_Roadmap.md Phase 9,
// 02_PRD.md Section 14 — Starter tier and above). One review per
// appointment, guest-submitted, never editable — see the schema header
// comment for how `appointmentId`'s uniqueness enforces both. Submission
// eligibility (appointment not cancelled, and its `endAt` has passed) is
// application logic, not a DB constraint — see src/lib/reviews.
model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  specialistId  String      @map("specialist_id")
  specialist    Specialist  @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("reviews")
}

model EmailVerificationToken {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at")
  consumedAt   DateTime?  @map("consumed_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id           String     @id @default(uuid())
  specialistId String     @map("specialist_id")
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at")
  consumedAt   DateTime?  @map("consumed_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([specialistId])
  @@map("password_reset_tokens")
}
